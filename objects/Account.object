<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Account_Rule</fullName>
        <active>true</active>
        <description>testing the Validation rules for the account.</description>
        <errorConditionFormula>OR(ISBLANK(Phone),
ISNULL(AnnualRevenue), 
ISBLANK( TEXT(Rating)))</errorConditionFormula>
        <errorMessage>Please fill all the Mandatory information</errorMessage>
    </validationRules>
</CustomObject>
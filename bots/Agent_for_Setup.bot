            </botSteps>
            <developerName>Error_Handling</developerName>
            <label>Unfortunately, a system error occurred. Let us start again.</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>The unique ID of the connected app used for migrating it to an external client app (ECA) or for summarizing the connected app details. This ID is sourced from the current connected app page in Setup and should be used only if the user has not explicitly m</description>
            <developerName>applicationId</developerName>
            <includeInPrompt>true</includeInPrompt>
            <label>applicationId</label>
            <visibility>External</visibility>
        </conversationVariables>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>The API name of the field of a Salesforce object that the user is viewing in the object field detail page in Setup. Do not use this field if user is already talking about another field in the conversation.</description>
            <developerName>currentField</developerName>
            <includeInPrompt>true</includeInPrompt>
            <label>currentField</label>
            <visibility>External</visibility>
        </conversationVariables>

    <validationRules>
        <fullName>G3rule</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(CONTAINS(Name, &apos;Corp&apos;))</errorConditionFormula>
        <errorMessage>Asset Name must contain &apos;g3&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>validationRule001</fullName>
        <active>false</active>
        <errorConditionFormula>ISBLANK(City)</errorConditionFormula>
        <errorMessage>data should be format DD/MM</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>validationRule002</fullName>
        <active>false</active>
        <errorConditionFormula>CONTAINS(Name, &quot;text&quot;)</errorConditionFormula>
        <errorDisplayField>City</errorDisplayField>
        <errorMessage>City should be the string</errorMessage>
    </validationRules>
</CustomObject>
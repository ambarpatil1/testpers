        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Hi! I&apos;m Agentforce, an AI assistant. I can do things like search your Salesforce data or the internet, edit your Salesforce records, and draft or revise emails and fields. Ask me &quot;What else can you do?&quot; to see how I can help simplify your work day.</message>
                    <messageIdentifier>e78cf765-4cfb-45a3-8c8b-e94f6e0cb2e5</messageIdentifier>
                </botMessages>
                <stepIdentifier>1f3a8fa0-8932-4704-b698-e62d028f1ae9</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>847689bc-82ea-49a9-a5d8-d54af6355530</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Welcome</developerName>
            <label>Welcome</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Something went wrong. Try again.</message>
                    <messageIdentifier>6ca36e6a-5cf8-4c44-bb28-2eeb603cb6a3</messageIdentifier>
                </botMessages>
                <stepIdentifier>c3057027-5fd0-45a1-8157-104963c4fec7</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>2f46cbf2-c59d-4a78-bd26-b851cd6a2847</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Rich_Content_Error_Handling</developerName>
            <label>Error Handler</label>

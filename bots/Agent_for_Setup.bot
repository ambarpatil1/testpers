                </botMessages>
                <stepIdentifier>adfcbc68-ea23-4fd8-81dd-17d4b091f502</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>cd648467-c4c5-498c-8b5b-190873970a99</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Welcome</developerName>
            <label>Hi! I&apos;m your helpful bot.</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Unfortunately, a system error occurred. Let us start again.</message>
                    <messageIdentifier>ccbc0aee-3d9a-4767-8612-a0b7a3c38c1c</messageIdentifier>
                </botMessages>
                <stepIdentifier>b94fd9cb-8409-44c0-be7a-954c3852e141</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>917146ed-03c6-4ba4-8958-00b26d92dc30</stepIdentifier>

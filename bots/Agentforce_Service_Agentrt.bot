    <botVersions>
        <fullName>v1</fullName>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Hi, I&apos;m an AI service assistant. How can I help you?</message>
                    <messageIdentifier>f52308c8-62b2-453f-9627-4f8be701b313</messageIdentifier>
                </botMessages>
                <stepIdentifier>45000f06-f436-43e2-8ae3-78b60518c0c5</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>fea58dcd-89ea-4ac3-ab82-a71688545c5f</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Welcome</developerName>
            <label>Hi! I&apos;m your helpful bot.</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Sorry, it looks like something has gone wrong.</message>
                    <messageIdentifier>3ebdc623-d37d-421b-bf4b-4b189a10eb74</messageIdentifier>
                </botMessages>
                <stepIdentifier>d2a0492d-b4b5-4b1d-b480-c355a3c66399</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <stepIdentifier>111d9a10-ab47-46df-a806-e1c537acb7fb</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Error_Handling</developerName>
            <label>Unfortunately, a system error occurred. Let us start again.</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>One moment while I connect you to the next available service representative.</message>
                    <messageIdentifier>a21f6f9c-a9f3-415f-846b-2670ea5c7e79</messageIdentifier>
                </botMessages>
                <stepIdentifier>9e805c04-5ff3-472b-a4ed-277704e00599</stepIdentifier>
                <type>Message</type>
            </botSteps>
            <botSteps>
                <conversationSystemMessage>
                    <type>Transfer</type>
                </conversationSystemMessage>
                <stepIdentifier>3e1a3a86-638d-43c5-b66b-ef750768ae7c</stepIdentifier>
                <type>SystemMessage</type>
            </botSteps>
            <developerName>Transfer_To_Agent</developerName>
            <label>Transfer To Agent</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <conversationVariables>
            <dataType>Text</dataType>
            <description>Stores the authentication key that&apos;s used to generate the verification code.</description>

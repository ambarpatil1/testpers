    <label>Email_validation</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Email__c</columns>
        <columns>companyName__c</columns>
        <columns>phone__c</columns>
        <columns>text40__c</columns>
        <columns>text60__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>companyName__c</field>
            <operation>contains</operation>
            <value>shiva</value>
        </filters>
        <filters>
            <field>phone__c</field>
            <operation>greaterThan</operation>
            <value>1</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Email_validation Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Email_validation</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>phoneVal</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  NOT(ISBLANK(phone__c)),
  NOT(REGEX(phone__c, &quot;\\d{3}-\\d{3}-\\d{4}&quot;))
)</errorConditionFormula>
        <errorMessage>Phone must be in format 123-456-7890</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>